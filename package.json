{
  "name": "celestial",
  "version": "8.0.0",
  "private": true,
  "type": "module",
  "description": "Celestial — four-app creative workspace with R3F, physical glass and community chat",
  "scripts": {
    "start": "node server.js",
    "dev": "npm run build && node server.js",
    "build": "vite build",
    "postinstall": "npm run build",
