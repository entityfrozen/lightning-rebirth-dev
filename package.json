    "check": "node --check server.js && node --test tests/*.test.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "dialkit": "^2.1.0",
    "motion": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
