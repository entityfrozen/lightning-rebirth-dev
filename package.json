{
  "name": "celestial",
  "version": "8.2.0",
  "private": true,
  "type": "module",
  "description": "Celestial — Xylora-faithful browser shell, aurora theme and Bolt-powered chat/AI/browser",
  "scripts": {
    "start": "node server.js",
    "dev": "npm run build && node server.js",
    "build": "vite build && vite build --config vite.boba.config.js && node scripts/inject-native-assets.mjs && node --check public/boba/chat.js && node --check public/boba/admin.js && npm test",
    "postinstall": "npm run build",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "check": "node --check server.js && node --test tests/*.test.js"
  },
  "dependencies": {
    "@mercuryworkshop/proxy-bootstrap": "^0.0.5",
    "ws": "^8.18.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "dialkit": "^2.1.0",
    "motion": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "vite": "^7.0.0",
    "@fluentui/react-icons": "^2.0.341",
    "javascript-obfuscator": "^5.8.0",
    "chess.js": "^1.4.0",
    "@titaniumnetwork-dev/ultraviolet": "3.2.10",
    "@mercuryworkshop/bare-mux": "2.1.9",
    "@mercuryworkshop/epoxy-transport": "2.1.28"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
