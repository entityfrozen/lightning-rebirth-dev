# Celestial — use local ./data by default.
PORT=3080

# On the EXISTING Railway service with the old /data volume:
# BOLT_DATA_DIR=/data
# LIGHTNING_DATA_FILE=/data/store.json
# Both must point inside the existing mounted volume, not the app filesystem.
# The server automatically backs up bolt.json, store.json and chat records.

# Admin bootstrap ONLY if no existing administrator is imported.
# Keep these in Railway service variables; never commit real credentials.
# BOLT_ADMIN_USER=your_admin_username
# BOLT_ADMIN_PASSWORD=choose-a-long-secret-password

# AI configuration remains server-side and optional.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# DISABLE_WEB_PROXY=1
